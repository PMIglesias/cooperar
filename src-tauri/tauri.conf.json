{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Cooperar",
  "version": "1.0.0",
  "identifier": "ar.com.puentedigital.cooperar",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      { "label": "main", "title": "Cooperar", "width": 1366, "height": 768, "minWidth": 1366, "minHeight": 768, "center": true }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}